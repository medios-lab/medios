#!/bin/sh
# medios-try: install and run a one-machine Medios preview in user space.
# Runs bin/medios_try.py on a uv-managed Python; see that file for subcommands.
set -eu
. "$(dirname "$0")/uv-env.sh"
exec "$uv" run --quiet --no-project --python "$MEDIOS_TRY_PYTHON" "$bundle/bin/medios_try.py" "$@"
